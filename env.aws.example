# Copie para .env.aws na EC2 e preencha os valores reais.
# Use senhas alfanumericas nos campos POSTGRES_PASSWORD e REDIS_PASSWORD para evitar problema em URL.

# Dominios e TLS
ACME_EMAIL=admin@seudominio.com.br
CHATWOOT_HOST=chatwoot.seudominio.com.br
AGENT_HOST=agent.seudominio.com.br
DASHBOARD_HOST=dashboard.seudominio.com.br
WAHA_HOST=waha.seudominio.com.br
FRONTEND_URL=https://chatwoot.seudominio.com.br
TRAEFIK_LOG_LEVEL=INFO

# Imagens
CHATWOOT_IMAGE=chatwoot/chatwoot:latest
WAHA_IMAGE=devlikeapro/waha:latest

# Chatwoot
SECRET_KEY_BASE=troque_por_um_valor_gerado_com_openssl_rand_hex_64
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=troqueestaSenhaPostgres123
POSTGRES_DB=chatwoot
REDIS_PASSWORD=troqueestaSenhaRedis123
ENABLE_ACCOUNT_SIGNUP=false
MAILER_SENDER_EMAIL=no-reply@seudominio.com.br
CHATWOOT_LOG_LEVEL=info
CHATWOOT_WEB_CONCURRENCY=1
CHATWOOT_RAILS_MAX_THREADS=3
CHATWOOT_SIDEKIQ_CONCURRENCY=2
CHATWOOT_MEM_LIMIT=1200m
CHATWOOT_WORKER_MEM_LIMIT=800m

# Agent - modelo/LLM
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_TOKENS=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TEMPERATURE=
GROQ_MAX_TOKENS=
AGENT_PROMPT_PROFILE=mariano
AGENT_PROFILE_ROUTING=false
AGENT_PROFILES_PATH=/app/app/profiles.mariano.json
ALLOW_GROUPS=false
MAX_REPLY_CHARS=1200

# Agent - Chatwoot API
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_INBOX_ID=
CHATWOOT_INBOX_IDENTIFIER=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_AI_STATUS=pending
CHATWOOT_HUMAN_STATUS=open

# Agent/Dashboard - Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=conversations_agent_sessions
SUPABASE_APP=delivery
SUPABASE_ENABLED=true
SUPABASE_SESSION_LIMIT=12
DASHBOARD_DB_SCHEMA=agent
DASHBOARD_CACHE_TTL_MS=60000
DASHBOARD_MEM_LIMIT=300m

# WAHA
WAHA_API_KEY_PLAIN=troqueestaChaveWahaLonga
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troqueestaSenhaDashboardWaha
WAHA_SESSION=default
WHATSAPP_HOOK_EVENTS=message
WAHA_LOG_LEVEL=info
WAHA_HTTP_LOG_LEVEL=warn
WAHA_MEM_LIMIT=700m

# Limites para EC2 medium com 4 GB RAM
AGENT_MEM_LIMIT=700m

# Vector stores opcionais
AGENT_VECTOR_STORE_ARIANE=
AGENT_VECTOR_STORE_MARIANO=
AGENT_VECTOR_STORE_MAIS_VISION=
AGENT_VECTOR_STORE_CRIOLASER=
AGENT_VECTOR_STORE_BIOVITA=
AGENT_VECTOR_STORE_ODENA=
