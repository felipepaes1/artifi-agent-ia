# Copie para .env.criolaser.aws na EC2 e preencha os valores reais.

# Dominios e TLS
ACME_EMAIL=admin@seudominio.com.br
WAHA_HOST=waha-criolaser.seudominio.com.br
AGENT_HOST=agent-criolaser.seudominio.com.br
TRAEFIK_LOG_LEVEL=INFO

# Imagens
WAHA_IMAGE=devlikeapro/waha-plus:latest

# Agent - modelo/LLM
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_TOKENS=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TEMPERATURE=
GROQ_MAX_TOKENS=
AGENT_PROMPT_PROFILE=criolaser
AGENT_PROFILE_ROUTING=false
AGENT_PROFILES_PATH=/app/app/profiles.criolaser.json
ALLOW_GROUPS=false
MAX_REPLY_CHARS=350

# Chatwoot desativado para este cliente
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_INBOX_ID=
CHATWOOT_INBOX_IDENTIFIER=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_AUTO_HANDOFF_ENABLED=false

# Supabase opcional
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=conversations_agent_sessions
SUPABASE_APP=criolaser
SUPABASE_ENABLED=true
SUPABASE_SESSION_LIMIT=12

# WAHA
WAHA_API_KEY_PLAIN=troqueestaChaveWahaLonga
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troqueestaSenhaDashboardWaha
WAHA_SESSION=default
WHATSAPP_HOOK_EVENTS=message.any
WAHA_ENGINE=NOWEB
WAHA_LICENSE_KEY=
WAHA_LOG_LEVEL=info
WAHA_HTTP_LOG_LEVEL=warn
WAHA_MEM_LIMIT=700m

# Limites para EC2 pequena/media
AGENT_MEM_LIMIT=700m

# Criolaser
CRIOLASER_AUDIO_BUCKET=audios_criolaser
AGENT_VECTOR_STORE_CRIOLASER=
